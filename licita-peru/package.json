{
  "name": "licita-peru-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "prueba:modelo": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/prueba-modelo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "docx": "^9.15.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.14",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
