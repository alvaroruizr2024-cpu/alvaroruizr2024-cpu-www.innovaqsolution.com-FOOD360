# ───────────── Obligatorias ─────────────
# PostgreSQL 14 o superior. Con poolers (Supabase, PgBouncer) use el puerto de transacciones.
DATABASE_URL=postgres://usuario:clave@host:5432/licita

# Clave de la API de Anthropic. Sin ella la plataforma funciona, pero el agente queda desactivado.
ANTHROPIC_API_KEY=

# ───────────── Operador de la plataforma ─────────────
# Correos (separados por coma) que al registrarse quedan como operadores: ven «Plataforma»,
# asignan planes y suspenden organizaciones. Regístrese primero con uno de ellos.
PLATFORM_ADMIN_EMAILS=
# 0 cierra el registro público: solo se entra por invitación.
REGISTRO_ABIERTO=1
# Plan que recibe una organización nueva (inicial | profesional | corporativo | uno propio).
PLAN_INICIAL=inicial
NEXT_PUBLIC_MARCA=LICITA PERÚ IA
# Razón social que opera el servicio (aparece en el pie legal) y contacto comercial.
NEXT_PUBLIC_OPERADOR=
NEXT_PUBLIC_CONTACTO_VENTAS=

# ───────────── Archivos ─────────────
# local: disco del servidor (requiere volumen persistente). s3: AWS S3, Cloudflare R2, Supabase Storage, MinIO.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
MAX_ARCHIVO_MB=40

# ───────────── Agente (opcionales) ─────────────
AGENT_MODEL=claude-opus-5-5
SPECIALIST_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Más esfuerzo = más calidad, más costo y más tiempo.
AGENT_EFFORT=high
SPECIALIST_EFFORT=medium
# default: ante un rechazo del clasificador de seguridad, el proveedor reintenta en otro modelo. off: lo desactiva.
AGENT_FALLBACKS=default
# 0 desactiva la búsqueda y lectura web del agente.
AGENT_WEB=1
AGENT_MAX_ITER=40
# Precio estimado por búsqueda web y precios por modelo (USD por millón de tokens), si cambian:
# PRECIO_BUSQUEDA_WEB_USD=0.01
# PRECIOS_MODELOS_JSON={"claude-opus-5-5":{"entrada":4,"salida":20,"lecturaCache":0.2,"escrituraCache":5}}

# ───────────── Otros ─────────────
SESSION_DAYS=14
# 0 para aplicar migraciones solo con `npm run db:migrate`.
AUTO_MIGRATE=1
# 1 = modo de prueba SIN modelo (guion fijo, no gasta tokens). Nunca en producción.
# AGENT_FAKE=1
